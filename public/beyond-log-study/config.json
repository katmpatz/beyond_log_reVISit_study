{
    "$schema": "https://raw.githubusercontent.com/revisit-studies/study/main/src/parser/StudyConfigSchema.json",
    "studyMetadata": {
        "title": "Beyond Log Study",
        "version": "pilot",
        "authors": [
            "Katerina Batziakoudi"
        ],
        "date": "2025-11-10",
        "description": "Online studies comparing bar charts for data with orders of magnitude differences",
        "organizations": [
            "Inria, France"
        ]
    },
    "baseComponents": {
        "image-instructions-component": {
            "previousButton": true,
            "nextButtonLocation": "sidebar",
            "response": [],
            "style": {
                "margin":"0 5vw",
                "maxHeight": "60vh",
                "maxWidth": "70vw"
            },
            "type": "image"
        },
        "task_value":{
            "instruction": "One category is selected, with orange rectangles around the bar. \n\nWhat is the value of the category?",
            "type": "react-component",
            "response": [
                {
                "id": "answer-difference",
                "prompt": "ANSWER",
                "infoText": "Provide an approximate estimation.",
                "type": "numerical",
                "placeholder": "Enter your estimation here",
                "location": "sidebar",
                "min": 0,
                "withDontKnow": true
                },
                {
                "id": "confidence-radio",
                "prompt": "How confident are you for your answer?",
                "type": "radio",
                "location": "sidebar",
                "options": [
                    "1 - Not Confident at all",
                    "2 - Slightly Confident",
                    "3 - Moderately Confident",
                    "4 - Very Confident",
                    "5 - Extremely Confident"
                ]
                }
            ],
            "nextButtonLocation": "sidebar",
            "instructionLocation": "sidebar"
    
        },
        "task_dif" : { 
            "instruction": "Two values are selected, with orange rectangles around the bars. \n\nWhat is the absolute difference between the values?",
            "type": "react-component",
            "response": [
                {
                "id": "answer-difference",
                "prompt": "ANSWER",
                "infoText": "Provide an approximate estimation. Don't use calculators.",
                "type": "numerical",
                "placeholder": "Enter your estimation here",
                "location": "sidebar",
                "min": 0,
                "withDontKnow": true
                },
                {
                "id": "confidence-radio",
                "prompt": "How confident are you for your answer?",
                "type": "radio",
                "location": "sidebar",
                "options": [
                    "1 - Not Confident at all",
                    "2 - Slightly Confident",
                    "3 - Moderately Confident",
                    "4 - Very Confident",
                    "5 - Extremely Confident"
                ]
                }
            ],
            "nextButtonLocation": "sidebar",
            "instructionLocation": "sidebar"
        }
    },
    "uiConfig": {
        "contactEmail": "aikaterini.batziakoudi@inria.fr",
        "helpTextPath": "beyond-log-study/assets/help.md",
        "logoPath": "revisitAssets/revisitLogoSquare.svg",
        "withProgressBar": false,
        "autoDownloadStudy": false,
        "withSidebar": true
    },
    "components": {
        "introduction": {
            "type": "markdown",
            "path": "beyond-log-study/assets/introduction.md",
            "response": []
        },
        "consent": {
            "type": "markdown",
            "path": "beyond-log-study/assets/consent.md",
            "nextButtonText": "Agree",
            "response": [
                {
                "id": "signature",
                "prompt": "Your signature",
                "location": "belowStimulus",
                "type": "shortText",
                "placeholder": "Please provide your signature"
                },
                {
                "id": "accept",
                "prompt": "Do you consent to the study and wish to continue?",
                "requiredValue": "Accept",
                "location": "belowStimulus",
                "type": "radio",
                "options": [
                    "Decline",
                    "Accept"
                ]
                }
            ]
        },
        "subjective-numeracy": {
            "type": "markdown",
            "path": "beyond-log-study/assets/numeracy.md",
            "nextButtonText": "Next",
            "response": [
                {
                    "id": "q1-numeracy",
                    "prompt": "How good are you at working with fractions?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Not good at all",
                    "rightLabel": "Extremely good"
                },
                {
                    "id": "fractions",
                    "prompt": "How good are you at working with fractions?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Not good at all",
                    "rightLabel": "Extremely good"
                },
                {
                    "id": "shirt",
                    "prompt": "How good are you at figuring out how much a shirt will cost if it is 25% off?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Not good at all",
                    "rightLabel": "Extremely good"
                },
                {
                    "id": "log",
                    "prompt": "How often do you read logarithmic charts?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Never",
                    "rightLabel": "Very often"
                },
                {
                    "id": "usefulness",
                    "prompt": "How often do you find numerical information to be useful?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Never",
                    "rightLabel": "Very often"
                },
                {
                    "id": "attention-1",
                    "prompt": "How often do you travel to the planet Mars to buy kiwis?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 6,
                    "withDivider": true,
                    "leftLabel": "Never",
                    "rightLabel": "Very often"
                }
            ]
        },
        "nasa-tlx": {
            "type": "markdown",
            "path": "beyond-log-study/assets/nasaTLX.md",
            "nextButtonText": "Proceed to the next block",
            "response": [
                {
                    "id": "mental-demand",
                    "prompt": "How mentally demanding were the tasks with this visualization design?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "temporal-demand",
                    "prompt": "How hurried or rushed was the pace of the tasks with this visualization design?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "success",
                    "prompt": "How successful were you in accomplishing what you were asked to do?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "effort",
                    "prompt": "How hard did you have to work to accomplish your level of performance?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "stress",
                    "prompt": "How insecure, discouraged, irritated, stressed, or annoyed were you?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "attention-2",
                    "prompt": "It's important that you pay attention to this study. Please tick 6. This is an attention check.",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "block-feedback",
                    "prompt": "Please take a moment to share any thoughts on your workload ratings.",
                    "location": "belowStimulus",
                    "type": "longText",
                    "placeholder": "What influenced your answers? Did any aspect of the visualization make the tasks easier or harder? Write NA if you have no comment."
                    }
            ]
        },
        "ranking": {
            "type": "markdown",
            "path": "beyond-log-study/assets/ranking.md",
            "nextButtonText": "Proceed to the next block",
            "response": [
                    {
                    "id": "ranking",
                    "prompt": "Please rank the visualizations based on your experience by selecting the one you preferred the most, followed by your second, third, and last choice in the table below.",
                    "location": "belowStimulus",
                    "type": "matrix-radio",
                    "answerOptions": [
                        "Logarithmic",
                        "EplusM",
                        "Multi-Magnitude",
                        "Bricks"
                    ],
                    "questionOrder": "fixed", 
                    "questionOptions": [
                        "Most Preffered",
                        "Second Choice",
                        "Third Choice",
                        "Less Preferred"
                    ]},
                {
                    "id": "ranking-feedback",
                    "prompt": "Please briefly explain the reasons for your ranking.",
                    "secondaryText": "What aspects influenced your choices? Consider factors like clarity, ease of use, efficiency, or any challenges you encountered.",
                    "location": "belowStimulus",
                    "type": "longText",
                    "placeholder": "Provide your feedback here."
                    },
                {
                    "id": "experience",
                    "prompt": "How successful were you in accomplishing what you were asked to do?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Very Low",
                    "rightLabel": "Very High"
                },
                {
                    "id": "effort",
                    "prompt": "How would you rate your overall experience with the experiment?",
                    "location": "belowStimulus",
                    "type": "likert",
                    "numItems": 7,
                    "withDivider": true,
                    "leftLabel": "Not Good at all",
                    "rightLabel": "Extremely Good"
                },
                {
                    "id": "problems-feedback",
                    "prompt": "Did you encounter any technical problems? Do you have any suggestions for improvement?",
                    "location": "belowStimulus",
                    "type": "longText",
                    "placeholder": "Provide your feedback here."
                    }
            ]
        },
        "training1": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/all-visualizations.svg",
        },
        "training2": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/log-axis.svg",
        },
        "training3": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/log-scale.gif",
        },
        "training4": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/log-inside-1.svg",
        },
        "training5": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/eplusm-inside-2.svg",
        },
        "training6": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/units-inside.svg"
        },
        "training7": {
            "baseComponent": "image-instructions-component",
            "path": "beyond-log-study/assets/img/instructions/multimag-1.svg"
        },
        "comprehension-check": {
            "type": "markdown",
            "path": "beyond-log-study/assets/comprenhension.md",
            "nextButtonText": "Ready to start the experiment",
            "previousButton": true,
            "previousButtonText": "Re-Read the instructions",
            "response": [
                {
                "id": "q-radio-comp-1",
                "prompt": "Based on the instructions you have just read, once you provided the answer what do you have to do?",
                "secondaryText": "You have two opportunities to get this question correct. Your answer will be recorded the moment you click on a choice, so please be sure of your selection before clicking.",
                "infoText": "Select the option that best represents your choice.",
                "type": "radio",
                "options": [
                    "State how difficult you found the task.",
                    "Wait one minute to be able to proceed to the next trial.",
                    "State how confident you are for your answer.",
                    "Provide textual feedback explaining the strategy you followed to find the answer.",
                ],
                "withOther": false
                },
                                {
                "id": "q-radio-comp-2",
                "prompt": "Based on the instructions you have just read, what will happen if you spent more than one and a half minute for a trial?",
                "secondaryText": "You have two opportunities to get this question correct. Your answer will be recorded the moment you click on a choice, so please be sure of your selection before clicking.",
                "infoText": "Select the option that best represents your choice.",
                "type": "radio",
                "options": [
                    "You will automatically move to the next trial.",
                    "You will have to provide textual feedback for the reasons of your delay.",
                    "The experiment will finish and you will be rejected.",
                    "The correct answer will be displayed and you will have to complete one extra trial."
                ],
                "withOther": false
                }
            ]  
        },
        "eplusm_value": {
            "baseComponent": "task_value",
            "description": "EplusM Bar Chart",
            "path": "beyond_log_study/assets/EplusM.jsx"
        },
        "eplusm_dif": {
            "baseComponent": "task_dif",
            "description": "EplusM Bar Chart",
            "path": "beyond_log_study/assets/EplusM.jsx"
        },
        "log_value": {
            "baseComponent": "task_value",
            "description": "Log Bar Chart",
            "path": "beyond_log_study/assets/Log.jsx"
        },
        "log_dif": {
            "baseComponent": "task_dif",
            "description": "Log Bar Chart",
            "path": "beyond_log_study/assets/Log.jsx"
        },
        "bricks_value": {
            "baseComponent": "task_value",
            "description": "Bricks Bar Chart",
            "path": "beyond_log_study/assets/Bricks.jsx"
        },
        "bricks_dif": {
            "baseComponent": "task_dif",
            "description": "Bricks Bar Chart",
            "path": "beyond_log_study/assets/Bricks.jsx"
        },
        "multimag_value": {
            "baseComponent": "task_value",
            "description": "Multi-Magnitude Bar Chart",
            "path": "beyond_log_study/assets/Multimag.jsx"
        },
        "multimag_dif": {
            "baseComponent": "task_dif",
            "description": "Multi-Magnitude Bar Chart",
            "path": "beyond_log_study/assets/Multimag.jsx"
        }
    },
    "sequence": {
        "order": "fixed",
        "components": [
            "introduction",
            "consent",
            "subjective-numeracy",
            "training1",
            "training2",
            "training3",
            "training4",
            "training5",
            "training6",
            "training7",
            "comprehension-check",
            {
                "order": "latinSquare",
                "components": [
                    {
                        "order": "fixed",
                        "components": [
                            {
                                "id": "visblock_eplusm_dynamic",
                                "order": "dynamic",
                                "functionPath": "beyond_log_study/assets/dynamic.tsx"
                            },
                            "nasa-tlx"
                        ]
                    },
                    {
                        "order": "fixed",
                        "components": [
                            {
                                "id": "visblock_bricks_dynamic",
                                "order": "dynamic",
                                "functionPath": "beyond_log_study/assets/dynamic.tsx"
                            },
                            "nasa-tlx"
                        ]
                    },
                    {
                        "order": "fixed",
                        "components": [
                            {
                                "id": "visblock_multimag_dynamic",
                                "order": "dynamic",
                                "functionPath": "beyond_log_study/assets/dynamic.tsx"
                            },
                            "nasa-tlx"
                        ]
                    },
                    {
                        "order": "fixed",
                        "components": [
                            {
                                "id": "visblock_log_dynamic",
                                "order": "dynamic",
                                "functionPath": "beyond_log_study/assets/dynamic.tsx"
                            },
                            "nasa-tlx"
                        ]
                    }
            ]
        },
        "ranking"
        ]
    }
}